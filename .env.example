# =============================================================================
# Fathers.com — environment template
# Copy to .env.local for development. Never commit real secrets.
# NEXT_PUBLIC_* is sent to the browser. Everything else is server-only.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Leave these blank for local/pilot. The app falls back to the Pilot project.
# Never paste a service-role key into a NEXT_PUBLIC_* variable.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Public app URL (required for auth redirects and email links) ------------
# Local: http://127.0.0.1:3000
# Production: https://your-production-domain
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Optional aliases. APP_URL wins for server-rendered email links.
# APP_URL=https://your-production-domain
# NEXT_PUBLIC_APP_URL=https://your-production-domain

# --- Supabase service role (server-only) -------------------------------------
# Required for /api/cron/reminders. Never import it into Client Components.
# SUPABASE_SERVICE_ROLE_KEY=

# --- YouTube Data API (optional, server-only) --------------------------------
# Used to fill session duration_seconds on save and for catalog backfill.
# When unset, admins enter runtime by hand. Sessions with a null duration are
# flagged as "Runtime missing" on /admin/trainings.
# YOUTUBE_API_KEY=

# --- Email (optional — no-op when unset so local/pilot still works) ----------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Fathers.com <noreply@mail.fathers.com>

# --- Reminders (optional — email fallback still works without push) ----------
# CRON_SECRET=long-random-string
# Vercel Cron (vercel.json) hits /api/cron/reminders at 07:00 UTC daily
# and /api/cron/streaks at 06:00 UTC daily. Both require Authorization:
# Bearer $CRON_SECRET. The dispatcher also needs SUPABASE_SERVICE_ROLE_KEY.
# npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@fathers.com

# --- Certificate mint (optional — default off) --------------------------------
# certificates_require_claim. When 1/true/on, issueCertificateToFather
# requires an active participant claim. Leave unset to keep Leader-issued
# completion proof on full session completion.
# CERTIFICATES_REQUIRE_CLAIM=

# --- Pilot test content (optional — default off) ------------------------------
# Issue 17. When 1/true/on, father shelves keep Test Training rows and
# Leader desks keep the Test! Did you receive note. Leave unset for demos.
# PILOT_SHOW_TEST_CONTENT=

# --- Roster practice light (default on) ---------------------------------------
# roster_practice_light. Leader-readable flag for Did you use this skill
# check-ins: completed, not yet, dismissed, or stale. No answer text.
# Leave unset to keep the quiet light on. Set to 0/false/off to hide it.
# ROSTER_PRACTICE_LIGHT=

# --- Counsel pack (organization flag, default off) ----------------------------
# counsel_pack_required lives on group_counsel_pack, not here. Super-admin
# turns it on per organization. Leave it off so Account hides the checklist.
# Downloads stay drafts. Attached marks are metadata only.

# --- Consider next (default off) ----------------------------------------------
# desk_consider_next_v1. Ranked next action per man on /manager. Leave unset
# until ranking is trustworthy. Set to 1/true/on/yes to show the card.
# DESK_CONSIDER_NEXT_V1=

# --- Leader assessment answers (default off) ----------------------------------
# leader_assessment_answers. Leaders see custom assessment completion only
# (started, finished, stalled) unless Super-admin turns the org flag on.
# Set LEADER_ASSESSMENT_ANSWERS=1 to unlock answer bodies for every org.
# Leave unset so the rehab spine stays flags-only.
# LEADER_ASSESSMENT_ANSWERS=

# --- Fidelity board (default off) ---------------------------------------------
# fidelity_board_enabled. Living supervision checklist and Certified
# Facilitator registry under Account and Desk. Leave unset for the prior desk.
# Set to 1/true/on/yes to show the board. No new ribbon item.
# FIDELITY_BOARD_ENABLED=

# --- Secure export (default off) ----------------------------------------------
# secure_export_enabled. Destination metadata and a confirm-first send stub.
# Leave unset so prior reports stay as they are. Quality improvement packet
# download stays on Reports either way. Set to 1/true/on/yes to show
# destinations. This desk does not send files to an outside host.
# SECURE_EXPORT_ENABLED=

# --- Armed Forces pack (default off) ------------------------------------------
# vertical_pack_armed_forces. Super-admin checklist stays at
# /admin/verticals/armed-forces. Leave unset so father and Leader
# surfaces stay as they are. Set to 1/true/on/yes to show the event
# closeout preset on Reports. Does not flip SHOW_MILITARY.
# VERTICAL_PACK_ARMED_FORCES=

# --- Optimization pack (default off) ------------------------------------------
# vertical_pack_optimization. Super-admin checklist stays at
# /admin/verticals/optimization. Leave unset so the rehab pilot stays
# as it is. Set to 1/true/on/yes to apply the bonded-group copy skin
# and commitment board on Performance Optimization Group desks. Rehab
# organizations never receive this pack.
# VERTICAL_PACK_OPTIMIZATION=

# --- Single sign-on (organization flag, default off) --------------------------
# sso_enabled lives on group_sso, not here. Super-admin turns it on per
# organization and links an OpenID Connect or SAML 2.0 provider. Leave it
# off so login stays email and password. Optional SCIM inbound:
# IDENTITY_SCIM_TOKEN=

# --- Sentry (optional — no-op when DSN unset) --------------------------------
# The DSN is designed to be public. Use NEXT_PUBLIC_SENTRY_DSN for the browser.
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Source-map upload (CI / Vercel only; never expose to the client):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
